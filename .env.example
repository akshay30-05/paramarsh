# Contact form email delivery (optional).
# Without these, the form still works: it opens the visitor's email app with
# the message filled in, addressed to queries@paramarsh.dev.
# Set real values only in .env.local (never committed) or in Vercel's env settings.

# API key from https://resend.com (server-side only; never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=

# Sender address on a domain verified in Resend, e.g. "Paramarsh Website <website@paramarsh.dev>"
CONTACT_FROM_EMAIL=

# Where messages are delivered (defaults to queries@paramarsh.dev)
CONTACT_TO_EMAIL=
